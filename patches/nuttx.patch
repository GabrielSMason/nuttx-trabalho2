index 75fedb3a55..3704aa9bba 100644
--- a/include/nuttx/sched.h
+++ b/include/nuttx/sched.h
@@ -417,6 +417,21 @@ struct stackinfo_s
                                          /* from the stack.                  */
 };
 
+/* struct deadlock_stats_s **************************************************/
+
+/* Used to report mutex deadlocks refused at lock time */
+
+#ifdef CONFIG_SCHED_DEADLOCK_DETECT
+struct deadlock_stats_s
+{
+  uint32_t  count;                       /* Deadlocks avoided since boot   */
+  uint8_t   len;                         /* Number of tasks in last cycle  */
+  pid_t     pids[CONFIG_SCHED_DEADLOCK_MAXDEPTH + 1]; /* last cycle        */
+  FAR void  *mutex;                      /* Mutex whose lock was refused   */
+  clock_t   ticks;                       /* System tick when it happened   */
+};
+#endif
+
 /* struct task_join_s *******************************************************/
 
 /* Used to save task join information */
@@ -1637,6 +1652,35 @@ pid_t nxsched_getppid(void);
 
 size_t nxsched_collect_deadlock(FAR pid_t *pid, size_t count);
 
+/****************************************************************************
+ * Name: sched_deadlock_enable
+ *
+ * Description:
+ *   Enable (1) or disable (0) mutex deadlock detection at lock time.
+ *
+ * Returned Value:
+ *   The previous state (0 or 1), or -1 with errno set to EINVAL if
+ *   'enable' is neither 0 nor 1.
+ *
+ ****************************************************************************/
+
+#ifdef CONFIG_SCHED_DEADLOCK_DETECT
+int sched_deadlock_enable(int enable);
+
+/****************************************************************************
+ * Name: sched_deadlock_info
+ *
+ * Description:
+ *   Copy the mutex deadlock statistics to 'info'.
+ *
+ * Returned Value:
+ *   0 on success, or -1 with errno set to EINVAL if 'info' is NULL.
+ *
+ ****************************************************************************/
+
+int sched_deadlock_info(FAR struct deadlock_stats_s *info);
+#endif
+
